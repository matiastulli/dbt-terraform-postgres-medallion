# Copy to .env (gitignored) and fill in, then: source .env   (from the repo root)
export DBT_PROFILES_DIR="$(pwd)"
export DBT_PG_PASSWORD=<choose-a-password>
export TF_VAR_dbt_user_password="$DBT_PG_PASSWORD"
export TF_VAR_analyst_password=<choose-another-password>
# Postgres superuser Terraform connects as. Homebrew creates one named after your OS user.
export TF_VAR_pg_admin_user="$USER"
